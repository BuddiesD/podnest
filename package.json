{
  "name": "podnest",
  "private": true,
  "scripts": {
    "build": "npm run build:vendor && npm run build:css && npm run build:js",
    "build:vendor": "node vendor.config.mjs",
    "build:css": "postcss web/static/src/css/index.css -o web/static/css/app.css --no-map",
    "build:js": "node esbuild.config.mjs",
    "watch": "npm run watch:css & npm run watch:js",
    "watch:css": "postcss web/static/src/css/index.css -o web/static/css/app.css --watch --no-map",
    "watch:js": "esbuild web/static/src/js/app.js --bundle --outfile=web/static/js/app.js --watch"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "latest",
    "@scalar/api-reference": "latest",
    "chart.js": "latest",
    "@fontsource/orbitron": "latest",
    "@fontsource/space-grotesk": "latest",
    "codemirror": "^5",
    "cssnano": "latest",
    "esbuild": "latest",
    "postcss": "latest",
    "postcss-banner": "latest",
    "postcss-cli": "latest",
    "postcss-import": "latest",
    "qrcode": "latest",
    "uikit": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true
  },
  "dependencies": {
    "npm": "^12.2.0"
  }
}
